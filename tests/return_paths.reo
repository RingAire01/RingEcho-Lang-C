/* All non-unit functions must return or diverge on every path. */
fn absval(x: i64) -> i64 { if x < 0 { return -x; } else { return x; } }

fn classify(x: i64) -> i64 { match x { 0 => 100, _ => 200 } }

fn pick(b: bool) -> i64 { (if b { 1 } else { 2 }) }

fn main() {
    assert(absval(-3) == 3);
    assert(absval(4) == 4);
    assert(classify(0) == 100);
    assert(classify(9) == 200);
    assert(pick(true) == 1);
    assert(pick(false) == 2);
}
