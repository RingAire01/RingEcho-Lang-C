const MAX: i64 = 100;
type Id = i64;

struct Point { x: i64, y: i64 }
enum Color { Red, Green, Blue }

trait Show {
    fn show(self) -> i64;
}

impl Show for Point {
    fn show(self) -> i64 {
        return self.x;
    }
}

component Counter {
    state count: i64,
    fn inc(self) {
        self.count = self.count + 1;
    }
}

module Utils {
    fn helper() -> i64 {
        return 42;
    }
}

fn main() {
    let p = Point { x: 10, y: 20 };
    let c = Color::Red;
    let result = match c {
        Color::Red => 1,
        Color::Green => 2,
        _ => 0,
    };
    println(result);
}
