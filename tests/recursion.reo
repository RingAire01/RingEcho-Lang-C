fn factorial(n: i64) -> i64 {
    if n <= 1 { return 1; }
    return n * factorial(n - 1);
}

fn gcd(a: i64, b: i64) -> i64 {
    if b == 0 { return a; }
    return gcd(b, a - (a / b) * b);
}

fn main() {
    println(factorial(5));
    println(factorial(10));
    println(gcd(48, 18));
    println(gcd(100, 75));
}
