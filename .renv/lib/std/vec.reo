/* std/vec — 动态整数向量(vec 句柄可跨函数传递) */
fn new_vec() -> vec { return vec_new() }
fn push_val(v: vec, x: i64) { vec_push(v, x) }
fn get_val(v: vec, i: i64) -> i64 { return vec_get(v, i) }
fn set_val(v: vec, i: i64, x: i64) { vec_set(v, i, x) }
fn pop_val(v: vec) -> i64 { return vec_pop(v) }
fn last_val(v: vec) -> i64 { return vec_last(v) }
fn size(v: vec) -> i64 { return vec_len(v) }
